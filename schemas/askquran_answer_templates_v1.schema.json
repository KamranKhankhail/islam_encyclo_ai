{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AskQuran Answer Templates v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "created_at_utc",
    "source",
    "templates"
  ],
  "properties": {
    "schema": {
      "const": "askquran_answer_templates_v1"
    },
    "version": {
      "type": "integer"
    },
    "created_at_utc": {
      "type": "string"
    },
    "source": {
      "type": "object"
    },
    "templates": {
      "type": "array",
      "items": { "$ref": "#/$defs/template" }
    }
  },
  "$defs": {
    "localizedString": {
      "type": "object",
      "properties": {
        "en": { "type": "string" },
        "ur": { "type": "string" },
        "ar": { "type": "string" }
      },
      "additionalProperties": true
    },
    "verseKeyArray": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]+:[0-9]+$"
      }
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "title",
        "verse_keys"
      ],
      "properties": {
        "id": { "type": "string" },
        "title": { "$ref": "#/$defs/localizedString" },
        "verse_keys": { "$ref": "#/$defs/verseKeyArray" }
      },
      "additionalProperties": true
    },
    "template": {
      "type": "object",
      "required": [
        "id",
        "title",
        "sections"
      ],
      "properties": {
        "id": { "type": "string" },
        "title": { "$ref": "#/$defs/localizedString" },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/$defs/section" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
